---
import DemoApp from "../components/demo/DemoApp.tsx";
import "../styles/demo.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ParaPDF demo</title>
    <meta
      name="description"
      content="Open a sample or your own PDF in ParaPDF, a fast PDF viewer for React built on pdf.js."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // The theme chosen in the documentation, which Starlight keeps; otherwise the system's.
      try {
        const theme = localStorage.getItem("starlight-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {
        // Storage may be blocked; the system's theme applies.
      }
    </script>
  </head>
  <body>
    <DemoApp client:only="react" />
    <noscript>The demo needs JavaScript.</noscript>
  </body>
</html>
