---
import DemoApp from "../components/demo/DemoApp.tsx";
import "../styles/demo.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ParaPDF demo</title>
    <meta
      name="description"
      content="Open a sample or your own PDF in ParaPDF, a fast PDF viewer for React built on pdf.js."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <DemoApp client:only="react" />
    <noscript>The demo needs JavaScript.</noscript>
  </body>
</html>
