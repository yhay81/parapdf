{
  "name": "parapdf",
  "version": "0.0.0",
  "private": true,
  "description": "The fastest PDF viewer for React (Phase 0 prototype)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE.md",
    "LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/declaration-imports.ts",
    "prepack": "pnpm run build && node scripts/legal-files.ts copy",
    "postpack": "node scripts/legal-files.ts remove",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "pdfjs-dist": ">=6.4.299",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
