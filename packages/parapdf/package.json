{
  "name": "parapdf",
  "version": "0.8.0",
  "description": "A fast PDF viewer for React, built on pdf.js",
  "keywords": [
    "pdf",
    "pdf.js",
    "pdfjs",
    "pdf-viewer",
    "react",
    "react-component",
    "viewer"
  ],
  "license": "Apache-2.0",
  "author": "Yusuke Hayashi",
  "homepage": "https://parapdf.yhay81.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhay81/parapdf.git",
    "directory": "packages/parapdf"
  },
  "bugs": {
    "url": "https://github.com/yhay81/parapdf/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./legacy": "./src/legacy.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./legacy": {
        "types": "./dist/legacy.d.ts",
        "default": "./dist/legacy.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "pdfjs",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/pdfjs-files.ts && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/declaration-imports.ts",
    "check:package": "node scripts/check-package.ts",
    "prepack": "pnpm run build && node scripts/legal-files.ts copy",
    "postpack": "node scripts/legal-files.ts remove",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p . && tsc -p test",
    "prepare": "node scripts/pdfjs-files.ts"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
