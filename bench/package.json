{
  "name": "@parapdf/bench",
  "private": true,
  "type": "module",
  "scripts": {
    "build:hayro": "RUSTFLAGS='-C target-feature=+simd128' wasm-pack build hayro-wasm --target web --release --out-dir pkg --no-pack",
    "build": "pnpm run build:hayro && vite build",
    "corpus": "node scripts/gen-synthetic.ts",
    "bench": "node scripts/run.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.6.6",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.65.0",
    "vite": "^8.3.8"
  }
}
